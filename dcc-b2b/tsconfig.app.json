{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "components/*": ["./src/components/*"],
      "components": ["./src/components"],
      "context/*": ["./src/context/*"],
      "context": ["./src/context"],
      "layout/*": ["./src/layout/*"],
      "layout": ["./src/layout"],
      "mock/*": ["./src/mock/*"],
      "mock": ["./src/mock"],
      "pages/*": ["./src/pages/*"],
      "pages": ["./src/pages"],
      "shared/*": ["./src/shared/*"],
      "shared": ["./src/shared"],
      "routes/*": ["./src/routes/*"],
      "routes": ["./src/routes"],
      "utils/*": ["./src/utils/*"],
      "utils": ["./src/utils"]
    },
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
